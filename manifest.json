{
  "manifest_version": 3,
  "name": "Scout",
  "version": "0.1.0",
  "description": "Optimize your resume for the job listing you're viewing.",
  "permissions": ["storage", "sidePanel", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://scout-backend.ngrok.app/*",
    "http://localhost:8000/*",
    "https://scout-frontend.ngrok.app/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/panel/index.html"
  },
  "action": {
    "default_title": "Open Scout",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/panel/index.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
